# Add these in Vercel > Project > Settings > Environment Variables (never put them in HTML files)

# Stripe (Dashboard > Developers > API keys). Use sk_test_... first, then sk_live_...
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe (Dashboard > Developers > Webhooks > your endpoint > Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Your live site URL (no trailing slash), used for Stripe success/cancel redirects
SITE_URL=https://yourdomain.com

# Google Cloud: enable "Routes API", create a server key (restrict to Routes API)
GOOGLE_MAPS_API_KEY=xxx

# Emails via Resend (resend.com). EMAIL_FROM must be on a domain you verified in Resend
RESEND_API_KEY=re_xxx
EMAIL_FROM=Flaky Bubbles <bookings@yourdomain.com>
# Where new paid bookings are emailed to your team
NOTIFY_EMAIL=info@flakybubbles.com
